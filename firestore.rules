rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Funções auxiliares de autenticação e permissão
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Validação de perfil de Administrador via whitelist na coleção /admins/{uid}
    function isAdmin() {
      return isAuthenticated() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Coleção de teste para validação de conectividade
    match /test/{testId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // Coleção de Administradores (apenas leitura para checagem, escrita bloqueada para clientes)
    match /admins/{adminId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // Documento principal do Usuário (apenas o próprio usuário autenticado pode ler ou gravar)
    match /users/{userId} {
      allow read: if isOwner(userId);

      // Criação inicial do perfil: não pode se autopromover a admin, créditos iniciais limitados a no máximo 5
      allow create: if isOwner(userId)
        && (!('isAdmin' in request.resource.data) || request.resource.data.isAdmin == false)
        && (!('credits' in request.resource.data) || request.resource.data.credits <= 5);

      // Atualização de perfil: o usuário comum NUNCA pode alterar isAdmin, id ou createdAt.
      // O campo 'credits' é protegido contra alterações arbitrárias via diff().affectedKeys()
      // e só pode ser debitado transacionalmente de 1 em 1 quando credits > 0.
      allow update: if isOwner(userId)
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['credits', 'isAdmin', 'id', 'createdAt'])
          ||
          (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['credits', 'updatedAt'])
            && resource.data.credits > 0
            && request.resource.data.credits == resource.data.credits - 1
          )
        );

      allow delete: if false;

      // Subcoleção: Itens do Inventário / Geladeira
      match /inventory/{itemId} {
        allow read, write: if isOwner(userId);
      }

      // Subcoleção: Histórico de Escaneamentos
      match /scans/{scanId} {
        allow read, write: if isOwner(userId);
      }

      // Subcoleção: Listas de Mercado
      match /shoppingLists/{listId} {
        allow read, write: if isOwner(userId);

        match /{subcollection=**} {
          allow read, write: if isOwner(userId);
        }
      }
    }

    // Coleção pública de Receitas (leitura pública, escrita restrita a administradores)
    match /recipes/{recipeId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}

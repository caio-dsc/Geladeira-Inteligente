rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Funções auxiliares de autenticação e permissão
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Validação de perfil de Administrador via whitelist na coleção /admins/{uid}
    function isAdmin() {
      return isAuthenticated() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Coleção de teste para validação de conectividade
    match /test/{testId} {
      allow read: if true;
    }

    // Coleção de Administradores (apenas leitura para checagem, escrita bloqueada para clientes)
    match /admins/{adminId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // Documento principal do Usuário (apenas o próprio usuário autenticado pode ler ou gravar)
    match /users/{userId} {
      allow read, create, update: if isOwner(userId);
      allow delete: if false;

      // Subcoleção: Itens do Inventário / Geladeira
      match /inventory/{itemId} {
        allow read, write: if isOwner(userId);
      }

      // Subcoleção: Histórico de Escaneamentos
      match /scans/{scanId} {
        allow read, write: if isOwner(userId);
      }
    }

    // Coleção pública de Receitas (leitura pública, escrita restrita a administradores)
    match /recipes/{recipeId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Funções auxiliares de autenticação e permissão
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Validação de perfil de Administrador via whitelist na coleção /admins/{uid}
    function isAdmin() {
      return isAuthenticated() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Coleção de teste para validação de conectividade
    match /test/{testId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // Coleção de Administradores (apenas leitura para checagem, escrita bloqueada para clientes)
    match /admins/{adminId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // Documento principal do Usuário (o próprio usuário ou Administrador)
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();

      // Criação inicial do perfil: usuário comum ou Administrador cadastrando
      allow create: if (
          isOwner(userId)
          && (!('isAdmin' in request.resource.data) || request.resource.data.isAdmin == false)
          && (!('scanEnabled' in request.resource.data) || request.resource.data.scanEnabled == false)
          && (!('credits' in request.resource.data) || request.resource.data.credits <= 5)
        ) || isAdmin();

      // Atualização de perfil: o usuário comum NUNCA pode alterar isAdmin, scanEnabled, credits, id ou createdAt.
      // Administrador tem permissão para alterar campos (incluindo scanEnabled para liberar usuários).
      allow update: if (
          isOwner(userId)
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['credits', 'isAdmin', 'scanEnabled', 'id', 'createdAt'])
        ) || isAdmin();

      allow delete: if isAdmin();

      // Subcoleção: Itens do Inventário / Geladeira
      match /inventory/{itemId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      // Subcoleção: Histórico de Escaneamentos
      match /scans/{scanId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      // Subcoleção: Listas de Mercado
      match /shoppingLists/{listId} {
        allow read, write: if isOwner(userId) || isAdmin();

        match /{subcollection=**} {
          allow read, write: if isOwner(userId) || isAdmin();
        }
      }
    }

    // Coleção de Clientes Pagos pré-cadastrados (Fase 7)
    match /paid_customers/{customerEmail} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Coleção pública de Receitas (leitura pública, escrita restrita a administradores)
    match /recipes/{recipeId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}

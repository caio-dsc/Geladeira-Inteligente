rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    
    // Funções de verificação e autorização
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && (
        firestore.exists(/databases/ai-studio-geladeiraintelig-ebd28962-2ea8-42ef-98cc-767ea5f182c5/documents/admins/$(request.auth.uid)) ||
        firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid))
      );
    }

    // Validação estrita de formato e tamanho de imagem para uploads seguros
    function isValidImage() {
      return request.resource.contentType.matches('image/(jpeg|png|webp)')
        && request.resource.size <= 10 * 1024 * 1024; // Máximo 10MB
    }

    // Avatar do usuário (leitura pública, escrita apenas pelo dono com arquivo de imagem válido)
    match /users/{userId}/avatar.jpg {
      allow read: if true;
      allow write: if isOwner(userId) && isValidImage();
    }

    // Fotografias de escaneamento da geladeira do usuário
    match /users/{userId}/scans/{scanId} {
      allow read: if isOwner(userId);
      allow write: if isOwner(userId) && isValidImage();
    }

    // Fotografias oficiais do catálogo de receitas (leitura pública, upload/escrita restrita a administradores)
    match /recipes/{recipeId}/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin() && isValidImage();
    }
  }
}
